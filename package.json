{
	"name": "@supertiny99/dsh-project-radar",
	"version": "0.1.0",
	"type": "module",
	"description": "DSH 本地项目雷达：发现并索引散落的 git 仓库，按活跃/待处理/休眠/无远程分诊，快速检索与打开。",
	"author": "supertiny99",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/supertiny99/dsh-project-radar.git"
	},
	"bugs": {
		"url": "https://github.com/supertiny99/dsh-project-radar/issues"
	},
	"homepage": "https://github.com/supertiny99/dsh-project-radar#readme",
	"keywords": [
		"dsh",
		"deepseek",
		"cordis",
		"plugin",
		"git",
		"projects",
		"dashboard"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"exports": {
		".": "./index.js",
		"./client": "./dist/client.js",
		"./package.json": "./package.json",
		"./icon": "./icon.svg"
	},
	"engines": {
		"dsh": ">=0.2.1-rc.5",
		"node": ">=20"
	},
	"files": [
		"index.js",
		"dist/client.js",
		"src/*.js",
		"cordis.patch.yml",
		"icon.svg",
		"README.md",
		"LICENSE"
	],
	"dependencies": {},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"immediately": true,
			"inject": [
				"@deepseek-ai/dsh-client-ui-conversation"
			]
		}
	},
	"scripts": {
		"build": "node scripts/build.mjs && node scripts/selfcheck.mjs",
		"watch": "node scripts/build.mjs --watch",
		"test": "node --test tests/*.test.mjs",
		"preflight": "node scripts/preflight.mjs",
		"prepare": "npm run build"
	},
	"devDependencies": {
		"esbuild": "^0.25.10",
		"react": "19.2.0",
		"react-dom": "19.2.0"
	}
}
